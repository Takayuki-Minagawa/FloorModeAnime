{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takayuki-minagawa.github.io/FloorModeAnime/schemas/floor-response-archive-v1.schema.json",
  "title": "Floor response archive v1",
  "description": "Physical floor-response field values for FloorModeAnime. Runtime validation additionally enforces node order and matrix dimensions.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "units",
    "coordinates",
    "quantity",
    "normalization",
    "node_order",
    "nodes",
    "faces",
    "time_s",
    "response_values",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "floor-response-archive/1" },
    "case_id": { "type": "string", "minLength": 1 },
    "units": {
      "type": "object",
      "required": ["length", "time", "response"],
      "properties": {
        "length": { "const": "m" },
        "time": { "const": "s" },
        "response": { "enum": ["m", "m/s", "m/s^2"] }
      },
      "additionalProperties": true
    },
    "coordinates": {
      "type": "object",
      "required": ["vertical_axis", "handedness"],
      "properties": {
        "vertical_axis": { "const": "z" },
        "handedness": { "const": "right" }
      },
      "additionalProperties": true
    },
    "quantity": {
      "enum": ["vertical_displacement", "vertical_velocity", "vertical_acceleration"]
    },
    "normalization": {
      "type": "object",
      "required": ["type", "reference"],
      "properties": {
        "type": { "const": "physical" },
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "node_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "z"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "node_ids"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "node_ids": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "node_i", "node_j"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "node_i": { "type": "integer", "minimum": 1 },
          "node_j": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "time_s": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "response_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "quantity": { "const": "vertical_displacement" } } },
      "then": { "properties": { "units": { "properties": { "response": { "const": "m" } } } } }
    },
    {
      "if": { "properties": { "quantity": { "const": "vertical_velocity" } } },
      "then": { "properties": { "units": { "properties": { "response": { "const": "m/s" } } } } }
    },
    {
      "if": { "properties": { "quantity": { "const": "vertical_acceleration" } } },
      "then": { "properties": { "units": { "properties": { "response": { "const": "m/s^2" } } } } }
    }
  ],
  "additionalProperties": true
}
